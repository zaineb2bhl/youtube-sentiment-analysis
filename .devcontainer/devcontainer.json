{
  "name": "YouTube Sentiment API",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Sentiment API", "onAutoForward": "notify" }
  },
  "postStartCommand": "bash scripts/start_api.sh"
}
